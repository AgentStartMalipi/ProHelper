# Entornos virtuales (run.bat / run_speak.bat los recrean)
.venv/
.venv-speak/

# Claves: solo va el .env.example
speak/.env
.env

# Datos personales (el repo es PRIVADO, verificado 2026-10-08): se suben respuestas, brief,
# perfiles, transcripciones y notas. Nunca los audios (pesan GB y pasan el limite de GitHub)
# ni la cache de documentos.
speak/data/**/*.wav
speak/data/kb_cache.json
*.log

# Python
__pycache__/
*.py[cod]

