# Copia este archivo como .env y ajusta. Nunca subas .env a ningun repo.

# --- LLM ---
# claude_cli = usa tu login de Claude Code (sin API key, como SCREEN)
# anthropic  = SDK oficial; requiere API_KEY (pip install anthropic)
LLM_PROVIDER=claude_cli
LLM_MODEL=claude-sonnet-5
LLM_EFFORT=low
API_KEY=

# --- Speech-to-text ---
# faster_whisper = local, gratis, sin internet
# assemblyai     = solo para Notas de llamada (mejor diarizacion); requiere key
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_LANGUAGE=en
# Idioma que se HABLA en Notas de llamada. Vacio = lo detecta en las primeras
# frases de cada hablante y lo fija. Con "en" una llamada en espanol sale
# TRADUCIDA al ingles (y al reves con "es").
NOTES_STT_LANGUAGE=
# Modelo para Notas en vivo (dos pistas a la vez): base da abasto en CPU; small no.
STT_LIVE_MODEL=base
# Hilos de Whisper (0 = todos los nucleos)
STT_THREADS=0
ASSEMBLYAI_API_KEY=

# --- Turnos ---
SILENCE_THRESHOLD=900
ANSWER_SILENCE=2500
MAX_SILENCE=6000
VAD_THRESHOLD=0

# --- Contexto ---
CONTEXT_WINDOW=3

# --- Voz del entrevistador ---
TTS_ENABLED=true
TTS_RATE=0

# --- Notas de llamada ---
# En vivo: cada cuantos segundos se reescribe el borrador de notas (0 = sin LLM en vivo)
LIVE_NOTES_INTERVAL=60

# --- Copiloto (respuestas en vivo con tus documentos) ---
COPILOT_ENABLED=true
# Carpeta con tus PDF, Word, PowerPoint, Markdown... (vacio = speak/data/knowledge)
KB_DIR=
# Silencio (s) del otro para dar su pregunta por terminada
COPILOT_QUIET_S=1.2
# Exploracion ("que me falta") en vivo: cada cuantos segundos (0 = solo boton F9)
DISCOVERY_INTERVAL=90
