# Copia este archivo como .env y ajusta. Nunca subas .env a ningun repo.

# --- LLM ---
# claude_cli = usa tu login de Claude Code (sin API key, como SCREEN)
# anthropic  = SDK oficial; requiere API_KEY (pip install anthropic)
LLM_PROVIDER=claude_cli
LLM_MODEL=claude-sonnet-5
LLM_EFFORT=low
API_KEY=

# --- Speech-to-text ---
# faster_whisper = local, gratis, sin internet
# deepgram       = nube, mucho mas preciso (en vivo y archivos); requiere key
# assemblyai     = solo para Notas de llamada (mejor diarizacion); requiere key
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_LANGUAGE=en
# Idioma que se HABLA en Notas de llamada. Vacio = lo detecta en las primeras
# frases de cada hablante y lo fija. Con "en" una llamada en espanol sale
# TRADUCIDA al ingles (y al reves con "es").
NOTES_STT_LANGUAGE=
# Modelo para Notas en vivo (dos pistas a la vez): base da abasto en CPU; small no.
STT_LIVE_MODEL=base
# Hilos de Whisper (0 = todos los nucleos)
STT_THREADS=0
ASSEMBLYAI_API_KEY=
# Deepgram Nova-3 (nube): mucho mas preciso que Whisper local, en vivo y en
# archivos. $200 gratis al registrarse en console.deepgram.com. Para usarlo:
# STT_PROVIDER=deepgram y deja STT_LANGUAGE vacio (espanol + ingles mezclados).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Terminos a reconocer tal cual, separados por coma (vacio = la lista de serie,
# con nombres tecnicos comunes y tus empresas). Agrega clientes, productos, personas.
# DEEPGRAM_KEYTERMS=Kubernetes,Redis,Azure,Ecoeffy

# --- Dispositivos ---
# Microfono: indice que recomienda `python -m speak --mics` (vacio = el de Windows)
MIC_DEVICE=
# Salida de la que se graba "Ellos" en Notas de llamada: parte del nombre
# (p. ej. Jabra, Headphones). Vacio = la salida por defecto. `--check` las lista.
LOOPBACK_DEVICE=

# --- Turnos ---
SILENCE_THRESHOLD=900
ANSWER_SILENCE=2500
MAX_SILENCE=6000
VAD_THRESHOLD=0

# --- Contexto ---
CONTEXT_WINDOW=3

# --- Voz del entrevistador ---
TTS_ENABLED=true
TTS_RATE=0

# --- Notas de llamada ---
# En vivo: cada cuantos segundos se reescribe el borrador de notas (0 = sin LLM en vivo)
LIVE_NOTES_INTERVAL=60
# Guardar el audio de cada llamada (me.wav + them.wav). false = se borra al
# terminar la transcripcion final; quedan la transcripcion y las notas
NOTES_KEEP_AUDIO=true
# false = la transcripcion final es la de En vivo y el audio no se vuelve a
# subir (boton "Transcribir audio" si quieres la version mas precisa)
NOTES_FINAL_FROM_AUDIO=false
# Aviso tras estos minutos grabando sin voz (0 = sin aviso)
NOTES_SILENCE_WARN_MIN=5

# --- Copiloto (respuestas en vivo con tus documentos) ---
COPILOT_ENABLED=true
# Atajo GLOBAL de "Responder ahora": funciona aunque estes en Teams o Meet
# (mismo metodo que SCREEN). Vacio = sin atajo global
COPILOT_HOTKEY=alt+r
# Carpeta con tus PDF, Word, PowerPoint, Markdown... (vacio = speak/data/knowledge)
KB_DIR=
# Silencio (s) del otro para dar su pregunta por terminada
COPILOT_QUIET_S=1.2
# Exploracion ("que me falta") en vivo: cada cuantos segundos (0 = solo boton F9)
DISCOVERY_INTERVAL=90
